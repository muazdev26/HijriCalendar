<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Exact-midnight rollover permissions: USE_EXACT_ALARM (Android 13+, auto-granted to
         calendar apps) plus SCHEDULE_EXACT_ALARM (Android 12, granted by default) so the widget
         flips at the exact local-midnight boundary on every supported API level. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application>
        <!-- System-broadcast catch-up receiver provided by the library -->
        <receiver
            android:name=".HijriWidgetUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Exact midnight alarm receiver provided by the library -->
        <receiver
            android:name=".HijriWidgetMidnightAlarmReceiver"
            android:exported="false" />
    </application>
</manifest>
