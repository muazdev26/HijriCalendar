<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="widget_background">#FBF7F1</color>
    <color name="widget_accent">#2E7D32</color>
    <color name="widget_text_primary">#1C1B1F</color>
    <color name="widget_text_secondary">#6E6A63</color>
    <color name="widget_today_background">#2E7D32</color>
    <color name="widget_on_today">#FFFFFF</color>
    <color name="widget_weekend_text">#B3261E</color>

    <!--
        Flattened stand-ins for the two out-of-month alphas the live Glance render computes at
        runtime: `primaryText.copy(alpha = 0.38f)` for the Hijri digit and `0.24f` for the Gregorian
        one (see `DayCell` in HijriCalendarWidget.kt). A `previewLayout` is inflated by the framework,
        not by Glance, so it cannot apply the alpha itself and needs the blend baked in.

        These are `widget_text_primary` (#1C1B1F) composited over `widget_background` (#FBF7F1) at
        the two alphas above. If either of those two colours changes, these need recomputing 
        `StaticPreviewLayoutTest` cannot see a colour value, so this comment is the only thing tying
        them together. Deliberately not asserted in a test: a colour assertion here would only
        prove the XML says what the XML says.
    -->
    <color name="widget_text_muted">#A6A3A1</color>
    <color name="widget_text_faint">#C5C2BF</color>
</resources>
