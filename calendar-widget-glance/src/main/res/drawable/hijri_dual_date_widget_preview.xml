<?xml version="1.0" encoding="utf-8"?>
<!-- Abstract vector used as android:previewImage on launchers below Android 12, which have neither
     previewLayout nor generated previews. Placeholder blocks in the live tile's five zones and colours,
     so the picker shows the tile's *shape* — accent band at the top, two sub-row ends, a dominant
     figure, a last line — rather than five indistinguishable tiles. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="@color/widget_background"
        android:pathData="M0,0h108v108h-108z" />

    <!-- The accent header band, at the top and flush to the edges, as the live tile draws it. -->
    <path
        android:fillColor="@color/widget_accent"
        android:pathData="M0,0h108v29h-108z" />

    <!-- The Gregorian sub-row's two ends. -->
    <path
        android:fillColor="@color/widget_text_secondary"
        android:pathData="M10,34h32v6h-32z" />
    <path
        android:fillColor="@color/widget_text_primary"
        android:pathData="M76,34h22v6h-22z" />

    <!-- The Hijri day figure, the largest block on the tile. -->
    <path
        android:fillColor="@color/widget_accent"
        android:pathData="M34,46h40v42h-40z" />

    <!-- The weekday, last. -->
    <path
        android:fillColor="@color/widget_text_primary"
        android:pathData="M32,94h44v9h-44z" />
</vector>
