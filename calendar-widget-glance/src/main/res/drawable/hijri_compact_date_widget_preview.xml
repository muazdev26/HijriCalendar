<?xml version="1.0" encoding="utf-8"?>
<!-- Abstract vector used as android:previewImage on launchers below Android 12, which have neither
     previewLayout nor generated previews. Placeholder blocks in the compact tile's three zones and
     colours — accent weekday band, then two date columns each with a dominant figure over a short
     caption — so the picker shows the tile's *shape* rather than an indistinguishable tile. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="@color/widget_background"
        android:pathData="M0,0h108v108h-108z" />

    <!-- The accent weekday band, flush to the top edge as the live tile draws it. -->
    <path
        android:fillColor="@color/widget_accent"
        android:pathData="M0,0h108v21h-108z" />

    <!-- Left column: the Gregorian day figure, then its month caption. -->
    <path
        android:fillColor="@color/widget_text_primary"
        android:pathData="M20,33h28v38h-28z" />
    <path
        android:fillColor="@color/widget_text_primary"
        android:pathData="M22,77h24v8h-24z" />

    <!-- Right column: the Hijri day figure (accent), then its month caption. -->
    <path
        android:fillColor="@color/widget_accent"
        android:pathData="M60,33h28v38h-28z" />
    <path
        android:fillColor="@color/widget_text_primary"
        android:pathData="M62,77h24v8h-24z" />
</vector>
