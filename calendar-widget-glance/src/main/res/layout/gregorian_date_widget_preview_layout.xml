<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview shown in the Android 12-14 widget picker for the Gregorian
     1x1 date tile: the weekday and month names over a big accent day figure, mirroring the live
     tile. Every size here is a hand-maintained mirror of DateTileTypography and must move with it;
     DateTilePreviewLayoutTest asserts they do. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="3dp"
    tools:ignore="UnusedAttribute">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:text="Thursday · August"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:text="21"
        android:textColor="@color/widget_accent"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
