<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview shown in the Android 12-14 widget picker for the resizable Hijri calendar
     grid widget. Mirrors the live render: centred one-line month title between the two nav
     arrows, the weekday row, then the 4x7 month grid with today's cell filled, so the picker
     shows real content instead of a placeholder. Android 15+ pickers use the richer generated
     preview published by HijriWidgetPreviewPublisher. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
