<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview mirror for the compact tile. Top to bottom:
     1. the accent band — the WEEKDAY name;
     2. the Gregorian row — day at one end, month at the other;
     3. the Hijri DAY, the largest line, in the family accent;
     4. the Hijri MONTH name, below the day.
     No year, era marker or separator anywhere. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:orientation="vertical"
    tools:ignore="UnusedAttribute">

    <!-- The accent band: the weekday name. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/widget_accent"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingLeft="6dp"
        android:paddingTop="2dp"
        android:paddingRight="6dp"
        android:paddingBottom="3dp"
        android:text="بدھ"
        android:textColor="@color/widget_on_today"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- The body, filling the rest of the cell. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal|center_vertical"
        android:orientation="vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <!-- 1. The Gregorian date: the day at one end, the month at the other. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="left"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="30"
                android:textColor="@color/widget_text_primary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- The projection's short form, which is what a live tile prints: the full English name
                 does not fit a half-width caption, and Urdu month names are never shortened. -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="right"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Oct"
                android:textColor="@color/widget_text_primary"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. The Hijri day — the largest line, in the family accent. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="15"
            android:textColor="@color/widget_accent"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 3. The Hijri month name, below the day. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="جمادى الاولى"
            android:textColor="@color/widget_text_primary"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
