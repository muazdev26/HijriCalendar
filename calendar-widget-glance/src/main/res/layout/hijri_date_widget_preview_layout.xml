<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview shown in the Android 12-14 widget picker for the Hijri
     1x1 date tile: the weekday name in the family's accent band, a big accent day figure in the
     middle, the month name at the bottom — mirroring the live tile. Every size here is a
     hand-maintained mirror of DateTileTypography and must move with it; DateTilePreviewLayoutTest
     asserts they do.

     The weekday size here is a snapshot at DateTileTypography's reference width. The live tile
     scales every line with the granted cell, so this static preview cannot follow it
     exactly - it shows the mid-range value.

     The band is a `match_parent` TextView carrying the accent fill, exactly as the dual-date tile's
     mirror does and as the live WeekdayBand draws it: one composable, so the four widgets that show
     a weekday cannot drift apart. Its text colour is `widget_on_today`, the token for text drawn
     *on* the accent.

     includeFontPadding="false" is what removes the strip of empty space above and below each glyph:
     a TextView reserves room for the font's full ascent and descent, and on these small sizes that
     reserved space is most of the visible line. The band below is the one line where it is what the
     LIVE tile does too: WeekdayBand draws its word through a raster cropped to its ink
     (WeekdayBandFit), so the band is ink-tall in the composition and in this mirror alike. The other
     two lines still reserve their font metrics live, so the mirror stays a little tighter than they
     are. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:orientation="vertical"
    tools:ignore="UnusedAttribute">

    <!-- The weekday band, flush to the tile's edges like the live WeekdayBand. Padding is
         WidgetBand's: 6dp horizontal, 2dp above the line box, 3dp below. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/widget_accent"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingLeft="6dp"
        android:paddingTop="2dp"
        android:paddingRight="6dp"
        android:paddingBottom="3dp"
        android:text="جمعرات"
        android:textColor="@color/widget_on_today"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- The body centres in the height the band left, matching the live weighted Box. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="٢١"
            android:textColor="@color/widget_accent"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="محرم"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
