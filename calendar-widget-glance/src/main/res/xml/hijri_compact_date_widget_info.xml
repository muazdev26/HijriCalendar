<?xml version="1.0" encoding="utf-8"?>
<!-- The compact dual-date tile (sixth widget): both dates at the smallest placement a launcher grants.

     Android has no sub-cell widgets, so the physical cell is the host's 1x1; the tile draws itself as a
     square on that cell's **smaller side** (CompactDateTileTypography.drawnEdgeDp) and centres it, so a
     placed 1x1 on a five-column phone launcher draws ~62x62dp inside its 62x88dp cell and a larger cell
     draws a larger square with larger type and background rather than extra transparent margin.
     `resizeMode="horizontal|vertical"` is what makes that growth reachable; it is **not** a switch to
     fill-the-cell, which was built, rejected as looking stretched, and reverted (the fill-the-cell
     variant turned the square into a 62x88 rectangle).

     `minWidth`/`minHeight` stay at 40dp: on launchers before Android 12 the cell count is derived from
     them (`cells = ceil((size + 30) / 70)`), so a larger minimum would make this a two-cell widget
     there — the opposite of what it is for. No `android:configure`: the library ships none, and this
     tile follows the family options mirror. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/hijri_compact_date_widget_description"
    android:initialLayout="@layout/hijri_widget_loading"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/hijri_compact_date_widget_preview"
    android:previewLayout="@layout/hijri_compact_date_widget_preview_layout"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute">
</appwidget-provider>
