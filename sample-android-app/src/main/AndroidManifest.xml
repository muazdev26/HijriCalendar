<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Calendar-app exact-alarm exemptions: auto-granted without a runtime prompt, lets the
         widget roll over at the exact local-midnight boundary (USE_EXACT_ALARM on Android 13+,
         SCHEDULE_EXACT_ALARM on Android 12). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".HijriCalendarApp"
        android:allowBackup="true"
        android:label="HijriCalendar Sample"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hijricalendar" android:host="today" />
            </intent-filter>
        </activity>

        <!-- The four widget <receiver> elements are declared by calendar-widget-glance and merged
             in from there (WG-10): AppWidgetManager discovers widgets by scanning the merged
             manifest, so a library that omitted them would give a consumer no widget at all.
             What the sample overrides is the provider *info* — its own res/xml copies below add
             `android:configure` + `widgetFeatures` pointing at this app's configuration
             activities. Resource merging resolves the library's `@xml/<name>` references to those
             overrides, so nothing here has to re-declare a receiver. -->

        <!-- Widget catalog: add any of the app's widgets straight from the home screen. -->
        <activity
            android:name=".WidgetCatalogActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- Per-widget configuration activities, owned by the sample and pointed at by the
             res/xml*/widget-info overrides. The library ships no configure activity; each widget
             type registers its own so the long-press and add-to-home flows both configure it. -->
        <activity
            android:name=".HijriWidgetConfigureActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".HijriTodayWidgetConfigureActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".HijriDateWidgetConfigureActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".GregorianDateWidgetConfigureActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- requestPinAppWidget success callback: confirms an added widget, so the add-to-home
             flow from WidgetCatalogActivity gives feedback. -->
        <receiver
            android:name=".WidgetAddSuccessReceiver"
            android:exported="false" />
    </application>
</manifest>