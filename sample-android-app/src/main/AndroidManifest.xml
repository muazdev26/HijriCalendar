<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Calendar-app exact-alarm exemption: auto-granted without a runtime prompt, lets the
         widget roll over at the exact local-midnight boundary. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:name=".HijriCalendarApp"
        android:allowBackup="true"
        android:label="HijriCalendar Sample"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hijricalendar" android:host="today" />
            </intent-filter>
        </activity>

        <!-- Home-screen widget; the host/provider ID lives in res/xml. -->
        <receiver
            android:name=".widget.HijriCalendarWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hijri_calendar_widget_info" />
        </receiver>

        <!-- Mandatory if a widget declares android:configure. -->
        <activity
            android:name=".HijriWidgetConfigureActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- System-broadcast catch-up: clock/timezone/locale changes and boot. ACTION_DATE_CHANGED
             is intentionally absent (not exempt from the API 26+ implicit-broadcast ban). -->
        <receiver
            android:name=".widget.HijriWidgetUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- No intent-filter by design: only the exact-midnight AlarmManager PendingIntent
             reaches this receiver, so it cannot be force-launched by other broadcasts. -->
        <receiver
            android:name=".widget.HijriWidgetMidnightAlarmReceiver"
            android:exported="false" />
    </application>
</manifest>